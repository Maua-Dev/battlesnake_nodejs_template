{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],

    /* rootDir na raiz do projeto para o tsc preservar as pastas:
       src/index.ts   -> dist/src/index.js   (é este o handler da Lambda)
       tests/x.test.ts -> dist/tests/x.test.js (é isto que o `npm test` roda) */
    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
